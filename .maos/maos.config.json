{
  "projectName": "maos",
  "routingMode": "auto",
  "providers": {
    "ollama": {
      "apiKey": "ollama",
      "baseURL": "http://localhost:11434/v1",
      "costPerMillionTokens": 0
    }
  },
  "agents": [
    {
      "id": "ARCHITECT",
      "role": "planner",
      "provider": "ollama",
      "model": "qwen2.5-coder",
      "capabilities": [
        "planning",
        "reasoning",
        "decomposition",
        "review"
      ],
      "scope": [
        "/"
      ],
      "maxIterations": 10,
      "costTier": "medium"
    },
    {
      "id": "BACKEND_DEV",
      "role": "coder",
      "provider": "ollama",
      "model": "qwen2.5-coder",
      "capabilities": [
        "coding",
        "apis",
        "database",
        "refactoring"
      ],
      "scope": [
        "src/",
        "package.json",
        "tsconfig.json"
      ],
      "maxIterations": 25,
      "costTier": "low"
    },
    {
      "id": "FRONTEND_DEV",
      "role": "designer",
      "provider": "ollama",
      "model": "qwen2.5-coder",
      "capabilities": [
        "design",
        "css",
        "frontend",
        "layout",
        "styling"
      ],
      "scope": [
        "src/",
        "public/",
        "index.html"
      ],
      "maxIterations": 20,
      "costTier": "low"
    }
  ],
  "routing": {
    "strategy": "capability_score",
    "costWeight": 0.3,
    "capabilityWeight": 0.7,
    "maxParallelAgents": 3,
    "fallbackProvider": "ollama"
  }
}