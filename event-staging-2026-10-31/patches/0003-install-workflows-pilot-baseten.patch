+}
+
+$policyText = Get-Content -LiteralPath $policy -Raw
+foreach ($requiredText in @('https://inference.baseten.co/v1', 'meta-models/muse-spark-open-1026', 'BASETEN_API_KEY')) {
+  if (-not $policyText.Contains($requiredText)) {
+    throw 'The installed application does not contain the reviewed Baseten hackathon model policy. Build and install the reviewed candidate first.'
+  }
+}
+
+$engine = (Resolve-Path -LiteralPath $ExternalEnginePath).Path
+if (-not (Test-Path -LiteralPath $engine -PathType Leaf)) {
+  throw 'Supply the separately obtained external MAOS engine with -ExternalEnginePath. The launcher never downloads or substitutes an engine.'
+}
+
+$node = Get-Command node.exe -ErrorAction SilentlyContinue
+if (-not $node) { throw 'Node.js 22.12 or newer must be on PATH for the installed MAOS service host.' }
+$nodeVersion = (& $node.Source --version).Trim()
+if ($LASTEXITCODE -ne 0 -or $nodeVersion -notmatch '^v?(\d+)\.(\d+)\.(\d+)') {
+  throw 'Could not read the Node.js version required by the installed MAOS service host.'
+}
+if ([version]::new([int]$Matches[1], [int]$Matches[2], [int]$Matches[3]) -lt [version]'22.12.0') {
+  throw "Node.js 22.12 or newer is required; found $nodeVersion."
+}
+
+$pilotRoot = Join-Path $env:TEMP ('maos-baseten-synthetic-pilot-' + [guid]::NewGuid().ToString('N'))
+$projectRoot = Join-Path $pilotRoot 'project'
+$userDataRoot = Join-Path $pilotRoot 'electron-user-data'
+$engineTarget = Join-Path $projectRoot 'rust/target/release/maos-engine.exe'
+New-Item -ItemType Directory -Path (Join-Path $projectRoot '.maos') -Force | Out-Null
+New-Item -ItemType Directory -Path (Join-Path $projectRoot 'synthetic') -Force | Out-Null
+New-Item -ItemType Directory -Path (Split-Path -Parent $engineTarget) -Force | Out-Null
+New-Item -ItemType Directory -Path $userDataRoot -Force | Out-Null
+Copy-Item -LiteralPath $engine -Destination $engineTarget
+
+$config = @{
+  schemaVersion = 1
+  projectName = 'baseten-synthetic-pilot'
+  profile = @{
+    id = 'industrial'
+    displayName = 'MAOS Industrial Synthetic Pilot'
+    mode = 'cloud'
+    zeroCloud = $false
+    evidenceRoot = 'synthetic'
+  }
+  routingMode = 'manual'
+  providers = @{
+    baseten = @{
+      baseURL = 'https://inference.baseten.co/v1'
+      basetenApiEnabled = $true
+    }
+  }
+  agents = @(@{
+    id = 'ANALYST_AGENT'
+    role = 'synthetic telemetry analyst'
+    runtime = 'api'
+    provider = 'baseten'
+    model = 'meta-models/muse-spark-open-1026'
+    timeoutMs = 60000
+    maxIterations = 4
+    allowedTools = @('analyze_telemetry_csv', 'task_complete')
+    capabilities = @('deterministic telemetry analysis')
+    scope = @('synthetic/')
+  })
+  routing = @{
+    strategy = 'capability_score'
+    costWeight = 0
+    capabilityWeight = 1
+    maxParallelAgents = 1
+    fallbackProvider = 'none'
+  }
+}
+$utf8NoBom = [System.Text.UTF8Encoding]::new($false)
+[System.IO.File]::WriteAllText((Join-Path $projectRoot '.maos/maos.config.json'), ($config | ConvertTo-Json -Depth 12), $utf8NoBom)
+
+$thresholds = @{
+  rulesetId = 'SYNTHETIC-PILOT-V1'
+  title = 'Synthetic demonstration thresholds'
+  disclaimer = 'Synthetic demonstration only; not an operational threshold or authorization.'
+  assetType = 'synthetic_turbine'
+  thresholds = @{
+    vibration_rms_mm_s = @{
+      unit = 'mm/s RMS'; warning = 4.5; critical = 7.1
+      recommendations = @{ WARNING = 'Synthetic warning only.'; FAIL = 'Synthetic critical result only.' }
+    }
+    bearing_temperature_c = @{
+      unit = 'deg C'; warning = 85.0; critical = 95.0
+      recommendations = @{ WARNING = 'Synthetic warning only.'; FAIL = 'Synthetic critical result only.' }
+    }
+  }
+}
+$demoRoot = Join-Path $projectRoot 'demo/industrial'
+New-Item -ItemType Directory -Path $demoRoot -Force | Out-Null
+[System.IO.File]::WriteAllText((Join-Path $demoRoot 'safety_thresholds.json'), ($thresholds | ConvertTo-Json -Depth 8), $utf8NoBom)
+$csv = @'
+sample_time,vibration_rms_mm_s,bearing_temperature_c
+2026-10-01T10:00:00Z,1.1,68
+2026-10-01T10:01:00Z,4.8,88
+2026-10-01T10:02:00Z,8.3,97
+'@
+[System.IO.File]::WriteAllText((Join-Path $projectRoot 'synthetic/pilot.csv'), $csv, $utf8NoBom)
+
+$engineHash = (Get-FileHash -LiteralPath $engineTarget -Algorithm SHA256).Hash.ToLowerInvariant()
+Write-Output 'Prepared a synthetic-only Baseten pilot project. The external engine is operator-supplied; this SHA-256 identifies bytes but does not attest publisher trust or approval.'
+Write-Output "Engine SHA-256: $engineHash"
+Write-Output "Synthetic project: $projectRoot"
+Write-Output "Synthetic CSV to select in MAOS: $(Join-Path $projectRoot 'synthetic/pilot.csv')"
+Write-Output 'The key value is inherited from this PowerShell session and is not written to files or process arguments.'
+Write-Output 'The GUI allows one analysis request at a time. Stop after any failure; do not retry this pilot.'
+
+$arguments = @(
+  "--user-data-dir=$userDataRoot",
+  $main,
+  '--project-root',
+  $projectRoot,
+  '--allow-temp'
+)
+$processTreeHelper = Join-Path $PSScriptRoot 'Windows-ProcessTree.ps1'
+if (-not (Test-Path -LiteralPath $processTreeHelper -PathType Leaf)) {
+  throw 'The task-owned process-tree helper is missing from this installation.'
+}
+. $processTreeHelper
+$cancelSource = [MaosPilotConsoleCancellation]::new()
+try {
+  $applicationExitCode = Invoke-MaosOwnedProcessTree -FilePath $electron -ArgumentList $arguments -WorkingDirectory $projectRoot -CancellationToken $cancelSource.Token
+} catch [System.OperationCanceledException] {
+  Write-Output 'Pilot cancelled; the task-owned application process tree was terminated and waited before releasing the launcher lock.'
+  $applicationExitCode = 130
+} finally {
+  $cancelSource.Dispose()
+}
+} finally {
+  $pilotMutex.ReleaseMutex()
+  $pilotMutex.Dispose()
+}
+exit $applicationExitCode
diff --git a/scripts/Windows-ProcessTree.ps1 b/scripts/Windows-ProcessTree.ps1
new file mode 100644
index 0000000..4b4eaac
--- /dev/null
+++ b/scripts/Windows-ProcessTree.ps1
@@ -0,0 +1,392 @@
+if (-not ('MaosPilotProcessTree' -as [type])) {
+  Add-Type -TypeDefinition @'
+using System;
+using System.ComponentModel;
+using System.Runtime.InteropServices;
+using System.Text;
+using System.Threading;
+
+public static class MaosPilotProcessTree
+{
+    private const uint CreateSuspended = 0x00000004;
+    private const uint JobObjectBasicAccountingInformation = 1;
+    private const uint JobObjectExtendedLimitInformation = 9;
+    private const uint KillOnJobClose = 0x00002000;
+    private const uint WaitObject0 = 0;
+
+    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
+    private struct StartupInfo
+    {
+        public int cb;
+        public string lpReserved;
+        public string lpDesktop;
+        public string lpTitle;
+        public int dwX;
+        public int dwY;
+        public int dwXSize;
+        public int dwYSize;
+        public int dwXCountChars;
+        public int dwYCountChars;
+        public int dwFillAttribute;
+        public int dwFlags;
+        public short wShowWindow;
+        public short cbReserved2;
+        public IntPtr lpReserved2;
+        public IntPtr hStdInput;
+        public IntPtr hStdOutput;
+        public IntPtr hStdError;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct ProcessInformation
+    {
+        public IntPtr hProcess;
+        public IntPtr hThread;
+        public uint dwProcessId;
+        public uint dwThreadId;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct IoCounters
+    {
+        public ulong ReadOperationCount;
+        public ulong WriteOperationCount;
+        public ulong OtherOperationCount;
+        public ulong ReadTransferCount;
+        public ulong WriteTransferCount;
+        public ulong OtherTransferCount;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct JobBasicAccountingInformation
+    {
+        public long TotalUserTime;
+        public long TotalKernelTime;
+        public long ThisPeriodTotalUserTime;
+        public long ThisPeriodTotalKernelTime;
+        public uint TotalPageFaultCount;
+        public uint TotalProcesses;
+        public uint ActiveProcesses;
+        public uint TotalTerminatedProcesses;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct JobBasicLimitInformation
+    {
+        public long PerProcessUserTimeLimit;
+        public long PerJobUserTimeLimit;
+        public uint LimitFlags;
+        public UIntPtr MinimumWorkingSetSize;
+        public UIntPtr MaximumWorkingSetSize;
+        public uint ActiveProcessLimit;
+        public UIntPtr Affinity;
+        public uint PriorityClass;
+        public uint SchedulingClass;
+    }
+
+    [StructLayout(LayoutKind.Sequential)]
+    private struct JobExtendedLimitInformation
+    {
+        public JobBasicLimitInformation BasicLimitInformation;
+        public IoCounters IoInfo;
+        public UIntPtr ProcessMemoryLimit;
+        public UIntPtr JobMemoryLimit;
+        public UIntPtr PeakProcessMemoryUsed;
+        public UIntPtr PeakJobMemoryUsed;
+    }
+
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    private static extern IntPtr CreateJobObject(IntPtr attributes, string name);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern bool SetInformationJobObject(IntPtr job, uint infoClass, ref JobExtendedLimitInformation info, uint length);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern bool QueryInformationJobObject(IntPtr job, uint infoClass, out JobBasicAccountingInformation info, uint length, out uint returnLength);
+
+    [DllImport("kernel32.dll", CharSet = CharSet.Unicode, SetLastError = true)]
+    private static extern bool CreateProcess(string applicationName, [In, Out, MarshalAs(UnmanagedType.LPWStr)] StringBuilder commandLine, IntPtr processAttributes, IntPtr threadAttributes, bool inheritHandles, uint creationFlags, IntPtr environment, string currentDirectory, ref StartupInfo startupInfo, out ProcessInformation processInformation);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern bool AssignProcessToJobObject(IntPtr job, IntPtr process);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern uint ResumeThread(IntPtr thread);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern uint WaitForSingleObject(IntPtr handle, uint milliseconds);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern bool TerminateJobObject(IntPtr job, uint exitCode);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern bool TerminateProcess(IntPtr process, uint exitCode);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern bool GetExitCodeProcess(IntPtr process, out uint exitCode);
+
+    [DllImport("kernel32.dll", SetLastError = true)]
+    private static extern bool CloseHandle(IntPtr handle);
+
+    public static int Run(string executable, string[] arguments, string workingDirectory, CancellationToken cancellationToken)
+    {
+        IntPtr job = IntPtr.Zero;
+        ProcessInformation process = new ProcessInformation();
+        bool created = false;
+        bool assigned = false;
+        try
+        {
+            job = CreateJobObject(IntPtr.Zero, null);
+            if (job == IntPtr.Zero) throw new Win32Exception(Marshal.GetLastWin32Error(), "Could not create the task-owned Windows Job Object.");
+            var limits = new JobExtendedLimitInformation();
+            limits.BasicLimitInformation.LimitFlags = KillOnJobClose;
+            if (!SetInformationJobObject(job, JobObjectExtendedLimitInformation, ref limits, (uint)Marshal.SizeOf(typeof(JobExtendedLimitInformation))))
+                throw new Win32Exception(Marshal.GetLastWin32Error(), "Could not configure the task-owned Windows Job Object.");
+
+            var startup = new StartupInfo();
+            startup.cb = Marshal.SizeOf(typeof(StartupInfo));
+            var commandText = new StringBuilder(Quote(executable));
+            foreach (var argument in arguments) commandText.Append(' ').Append(Quote(argument));
+            var commandLine = new StringBuilder(commandText.ToString(), commandText.Length + 1);
+            if (!CreateProcess(executable, commandLine, IntPtr.Zero, IntPtr.Zero, false, CreateSuspended, IntPtr.Zero, workingDirectory, ref startup, out process))
+                throw new Win32Exception(Marshal.GetLastWin32Error(), "Could not start the task-owned application process.");
+            created = true;
+
+            if (!AssignProcessToJobObject(job, process.hProcess))
+                throw new Win32Exception(Marshal.GetLastWin32Error(), "Could not assign the application to its task-owned process tree.");
+            assigned = true;
+
+            if (ResumeThread(process.hThread) == uint.MaxValue)
+                throw new Win32Exception(Marshal.GetLastWin32Error(), "Could not resume the task-owned application process.");
+
+            while (true)
+            {
+                if (cancellationToken.IsCancellationRequested)
+                {
+                    TerminateJobObject(job, 130);
+                    WaitForJobEmpty(job);
+                    throw new OperationCanceledException(cancellationToken);
+                }
+
+                uint activeProcesses = GetActiveProcessCount(job);
+                if (activeProcesses == 0)
+                {
+                    uint completedCode;
+                    if (!GetExitCodeProcess(process.hProcess, out completedCode))
+                        throw new Win32Exception(Marshal.GetLastWin32Error(), "Could not read the task-owned application exit code.");
+                    return unchecked((int)completedCode);
+                }
+
+                uint exitCode;
+                if (WaitForSingleObject(process.hProcess, 0) == WaitObject0 && GetExitCodeProcess(process.hProcess, out exitCode) && exitCode != 0)
+                {
+                    TerminateJobObject(job, exitCode);
+                    WaitForJobEmpty(job);
+                    return unchecked((int)exitCode);
+                }
+                Thread.Sleep(25);
+            }
+        }
+        catch
+        {
+            if (assigned)
+            {
+                TerminateJobObject(job, 1);
+                WaitForJobEmpty(job);
+            }
+            else if (created)
+            {
+                TerminateProcess(process.hProcess, 1);
+                WaitForSingleObject(process.hProcess, uint.MaxValue);
+            }
+            throw;
+        }
+        finally
+        {
+            if (job != IntPtr.Zero)
+            {
+                if (GetActiveProcessCount(job) > 0)
+                {
+                    TerminateJobObject(job, 1);
+                    WaitForJobEmpty(job);
+                }
+                CloseHandle(job);
+            }
+            if (process.hThread != IntPtr.Zero) CloseHandle(process.hThread);
+            if (process.hProcess != IntPtr.Zero) CloseHandle(process.hProcess);
+        }
+    }
+
+    private static uint GetActiveProcessCount(IntPtr job)
+    {
+        JobBasicAccountingInformation info;
+        uint returnLength;
+        if (!QueryInformationJobObject(job, JobObjectBasicAccountingInformation, out info, (uint)Marshal.SizeOf(typeof(JobBasicAccountingInformation)), out returnLength))
+            throw new Win32Exception(Marshal.GetLastWin32Error(), "Could not inspect the task-owned process tree.");
+        return info.ActiveProcesses;
+    }
+
+    private static void WaitForJobEmpty(IntPtr job)
+    {
+        while (GetActiveProcessCount(job) > 0) Thread.Sleep(25);
+    }
+
+    private static string Quote(string value)
+    {
+        var result = new StringBuilder("\"");
+        int slashes = 0;
+        foreach (char character in value)
+        {
+            if (character == '\\') { slashes++; continue; }
+            if (character == '\"')
+            {
+                result.Append('\\', slashes * 2 + 1).Append('\"');
+                slashes = 0;
+                continue;
+            }
+            result.Append('\\', slashes).Append(character);
+            slashes = 0;
+        }
+        result.Append('\\', slashes * 2).Append('\"');
+        return result.ToString();
+    }
+}
+public sealed class MaosPilotConsoleCancellation : IDisposable
+{
+    [ThreadStatic]
+    private static System.Collections.Generic.List<MaosPilotConsoleCancellation> callbackAdapters;
+    private readonly object lifetimeGate = new object();
+    private readonly CancellationTokenSource cancellation = new CancellationTokenSource();
+    private readonly ConsoleCancelEventHandler handler;
+    private int activeCallbacks;
+    private bool disposeRequested;
+    private bool sourceDisposeStarted;
+    private bool sourceDisposed;
+
+    public CancellationToken Token { get { return cancellation.Token; } }
+
+    public MaosPilotConsoleCancellation()
+    {
+        handler = new ConsoleCancelEventHandler(HandleCancel);
+        Console.CancelKeyPress += handler;
+    }
+
+    private void HandleCancel(object sender, ConsoleCancelEventArgs eventArgs)
+    {
+        lock (lifetimeGate)
+        {
+            if (disposeRequested) return;
+            activeCallbacks++;
+        }
+
+        if (callbackAdapters == null) callbackAdapters = new System.Collections.Generic.List<MaosPilotConsoleCancellation>();
+        callbackAdapters.Add(this);
+        try
+        {
+            if (eventArgs != null) eventArgs.Cancel = true;
+            // Cancel invokes token callbacks synchronously; never hold lifetimeGate here.
+            cancellation.Cancel();
+        }
+        finally
+        {
+            callbackAdapters.RemoveAt(callbackAdapters.Count - 1);
+            CallbackExited();
+        }
+    }
+
+    public void Dispose()
+    {
+        lock (lifetimeGate) disposeRequested = true;
+        try
+        {
+            Console.CancelKeyPress -= handler;
+        }
+        finally
+        {
+            if (callbackAdapters == null || !callbackAdapters.Contains(this)) DisposeAndWaitForCallbacks();
+            else DisposeSourceIfQuiescent();
+        }
+    }
+
+    private void CallbackExited()
+    {
+        bool dispose = false;
+        lock (lifetimeGate)
+        {
+            activeCallbacks--;
+            if (activeCallbacks == 0)
+            {
+                Monitor.PulseAll(lifetimeGate);
+                if (disposeRequested && !sourceDisposeStarted)
+                {
+                    sourceDisposeStarted = true;
+                    dispose = true;
+                }
+            }
+        }
+        if (dispose) DisposeCancellationSource();
+    }
+
