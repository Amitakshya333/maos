+    await expect(service.analyze(project.root, { request: 'Analyze this file.', sourcePath: project.sourcePath }))
+      .rejects.toMatchObject<Partial<IndustrialAnalysisAgentError>>({ code: 'ANALYSIS_TOOL_NOT_USED' });
+  });
+
+});
