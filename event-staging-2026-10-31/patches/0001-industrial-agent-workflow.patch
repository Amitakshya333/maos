+      const section = page.getByRole('region', { name: 'T-07 judged run' });
+      await section.getByText(/PENDING APPROVAL · FAIL/).waitFor();
+      const match = /Run\s+(judged-run-[a-zA-Z0-9-]+)/.exec(await section.innerText());
