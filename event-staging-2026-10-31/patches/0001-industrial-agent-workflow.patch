+    }
+    if (typeof run.summary !== 'string' || !run.summary.includes(evidence.analysisId)) {
+      throw new IndustrialAnalysisAgentError('EVIDENCE_REFERENCE_REQUIRED', 'The model explanation did not cite its analysisId.');
+    }
