@@ -0,0 +1,60 @@
+param(
+  [Parameter(Mandatory = $true)][string]$PackageArchive,
+  [Parameter(Mandatory = $true)][string]$SourceRevision,
+  [Parameter(Mandatory = $true)][string]$SourceDeltaSha256,
+  [Parameter(Mandatory = $true)][string]$OutputBundle
+)
+
+$ErrorActionPreference = 'Stop'
+$sourceRoot = (Resolve-Path -LiteralPath (Join-Path $PSScriptRoot '..')).Path
+$archivePath = (Resolve-Path -LiteralPath $PackageArchive).Path
+$outputPath = [System.IO.Path]::GetFullPath($OutputBundle)
+if (Test-Path -LiteralPath $outputPath) { throw "Output bundle already exists: $outputPath" }
+if ($SourceRevision -notmatch '^[0-9a-f]{40}$') { throw 'SourceRevision must be a full 40-character Git commit.' }
+if ($SourceDeltaSha256 -notmatch '^[0-9a-f]{64}$') { throw 'SourceDeltaSha256 must be a full lowercase SHA-256.' }
+
+$package = Get-Content -LiteralPath (Join-Path $sourceRoot 'package.json') -Raw | ConvertFrom-Json
+$packagePath = Join-Path $sourceRoot 'package.json'
+$lockPath = Join-Path $sourceRoot 'package-lock.json'
+$lockCheck = "const p=require(process.argv[1]); const l=require(process.argv[2]); const r=l.packages['']; if(p.name!==l.name||p.version!==l.version||r.name!==p.name||r.version!==p.version) process.exit(1); for(const group of ['dependencies','devDependencies']) for(const [name,range] of Object.entries(p[group]||{})) if((r[group]||{})[name]!==range) process.exit(1);"
+& node.exe -e $lockCheck $packagePath $lockPath
+if ($LASTEXITCODE -ne 0) { throw 'package.json and package-lock.json identity or direct dependencies do not match.' }
+
+$archiveEntries = & tar.exe -tzf $archivePath
+if ($LASTEXITCODE -ne 0) { throw 'Could not list the npm package archive.' }
+if ($archiveEntries -notcontains 'package/desktop/package-lock.json' -or
+    $archiveEntries -notcontains 'package/desktop/package.json') {
+  throw 'The npm archive does not contain the pinned desktop package and lockfile.'
+}
+
+$parent = Split-Path -Parent $outputPath
+if (-not (Test-Path -LiteralPath $parent)) { throw "Output directory does not exist: $parent" }
+$stageRoot = Join-Path ([System.IO.Path]::GetFullPath($env:TEMP)) ('maos-install-bundle-' + [guid]::NewGuid().ToString('N'))
+New-Item -ItemType Directory -Path $stageRoot | Out-Null
+try {
+  $bundleArchive = Join-Path $stageRoot 'maosorch.tgz'
+  Copy-Item -LiteralPath $archivePath -Destination $bundleArchive
+  Copy-Item -LiteralPath (Join-Path $sourceRoot 'package-lock.json') -Destination (Join-Path $stageRoot 'package-lock.json')
+  Copy-Item -LiteralPath (Join-Path $PSScriptRoot 'Install-MaosIndustrial.ps1') -Destination (Join-Path $stageRoot 'Install-MaosIndustrial.ps1')
+
+  $manifest = [ordered]@{
+    schemaVersion = 1
+    sourceRevision = $SourceRevision
+    sourceDeltaSha256 = $SourceDeltaSha256
+    package = @{ name = $package.name; version = $package.version; archive = 'maosorch.tgz'; sha256 = (Get-FileHash -LiteralPath $bundleArchive -Algorithm SHA256).Hash.ToLowerInvariant() }
+    applicationLock = @{ path = 'package-lock.json'; sha256 = (Get-FileHash -LiteralPath (Join-Path $stageRoot 'package-lock.json') -Algorithm SHA256).Hash.ToLowerInvariant() }
+    desktopLock = @{ path = 'package/desktop/package-lock.json'; sha256 = (Get-FileHash -LiteralPath (Join-Path $sourceRoot 'desktop/package-lock.json') -Algorithm SHA256).Hash.ToLowerInvariant() }
+    installer = @{ path = 'Install-MaosIndustrial.ps1'; sha256 = (Get-FileHash -LiteralPath (Join-Path $stageRoot 'Install-MaosIndustrial.ps1') -Algorithm SHA256).Hash.ToLowerInvariant() }
+  }
+  $manifest | ConvertTo-Json -Depth 5 | Set-Content -LiteralPath (Join-Path $stageRoot 'bundle-manifest.json') -Encoding UTF8
+  Compress-Archive -Path (Join-Path $stageRoot '*') -DestinationPath $outputPath
+} finally {
+  $tempRoot = [System.IO.Path]::GetFullPath($env:TEMP).TrimEnd('\') + '\'
+  $resolvedStage = [System.IO.Path]::GetFullPath($stageRoot)
+  if ($resolvedStage.StartsWith($tempRoot, [System.StringComparison]::OrdinalIgnoreCase) -and
+      (Split-Path -Leaf $resolvedStage) -like 'maos-install-bundle-*') {
+    Remove-Item -LiteralPath $resolvedStage -Recurse -Force
+  }
+}
+
+Write-Output "Created lockfile bootstrap bundle: $outputPath"
diff --git a/scripts/prepare-hooks.js b/scripts/prepare-hooks.js
new file mode 100644
index 0000000..74f0ff7
--- /dev/null
+++ b/scripts/prepare-hooks.js
@@ -0,0 +1,11 @@
+const fs = require('node:fs');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+
+if (!fs.existsSync(path.join(process.cwd(), '.git'))) process.exit(0);
+
+const husky = path.join(process.cwd(), 'node_modules', 'husky', 'bin.js');
+if (!fs.existsSync(husky)) throw new Error('Husky is required when preparing hooks in a Git checkout.');
+const result = spawnSync(process.execPath, [husky], { stdio: 'inherit' });
+if (result.error) throw result.error;
+process.exitCode = result.status ?? 1;
diff --git a/tests/cli/doctor.test.ts b/tests/cli/doctor.test.ts
new file mode 100644
index 0000000..87cdcd9
--- /dev/null
+++ b/tests/cli/doctor.test.ts
@@ -0,0 +1,163 @@
+import * as fs from 'node:fs';
+import * as os from 'node:os';
+import * as path from 'node:path';
+import { afterEach, describe, expect, it, vi } from 'vitest';
+
+const engine = vi.hoisted(() => ({
+  engineHealth: vi.fn(),
+  getDefaultEnginePath: vi.fn((root: string) => `${root}/rust/target/release/maos-engine${process.platform === 'win32' ? '.exe' : ''}`),
+  verifyExecutable: vi.fn(),
+}));
+
+vi.mock('../../src/industrial/rust-engine-bridge', () => engine);
+
+import { runDoctor } from '../../src/cli/doctor';
+
+const roots: string[] = [];
+let originalCwd = '';
+
+function createProject(config?: unknown): string {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'maos-doctor-'));
+  roots.push(root);
+  if (config !== undefined) {
+    const maosRoot = path.join(root, '.maos');
+    fs.mkdirSync(maosRoot, { recursive: true });
+    fs.writeFileSync(path.join(maosRoot, 'maos.config.json'), JSON.stringify(config));
+  }
+  originalCwd = process.cwd();
+  process.chdir(root);
+  return root;
+}
+
+function localConfig(overrides: Record<string, unknown> = {}) {
+  return {
+    schemaVersion: 1,
+    projectName: 'doctor-test',
+    providers: { ollama: { baseURL: 'http://127.0.0.1:11434/v1' } },
+    agents: [{ id: 'LOCAL', runtime: 'local', provider: 'ollama', model: 'local-model' }],
+    ...overrides,
+  };
+}
+
+afterEach(() => {
+  if (originalCwd) process.chdir(originalCwd);
+  originalCwd = '';
+  vi.restoreAllMocks();
+  vi.unstubAllGlobals();
+  engine.engineHealth.mockReset();
+  engine.verifyExecutable.mockReset();
+  for (const root of roots.splice(0)) fs.rmSync(root, { recursive: true, force: true });
+});
+
+describe('maos doctor readiness', () => {
+  it('reports a configured local project ready without sending inference requests', async () => {
+    createProject(localConfig());
+    const requests = vi.fn(async () => new Response());
+    vi.stubGlobal('fetch', requests);
+    vi.spyOn(console, 'log').mockImplementation(() => {});
+
+    const result = await runDoctor();
+
+    expect(result.exitCode).toBe(0);
+    expect(result.readiness).toBe('ready_with_warnings');
+    expect(result.checks.find((check) => check.label === 'CLI runtimes')).toMatchObject({ required: false, status: 'warn' });
+    expect(requests).not.toHaveBeenCalled();
+  });
+
+  it('returns a required nonzero readiness result for missing configuration', async () => {
+    createProject();
+    vi.spyOn(console, 'log').mockImplementation(() => {});
+
+    const result = await runDoctor();
+
+    expect(result).toMatchObject({ readiness: 'not_ready', exitCode: 1 });
+    expect(result.checks.find((check) => check.label === 'Config')).toMatchObject({ required: true, status: 'fail' });
+  });
+
+  it('returns a required nonzero readiness result for missing credentials', async () => {
+    createProject({
+      schemaVersion: 1,
+      projectName: 'doctor-test',
+      providers: { freemodel: { baseURL: 'http://127.0.0.1:9000/v1' } },
+      agents: [{ id: 'API', runtime: 'api', provider: 'freemodel', model: 'local-test' }],
+    });
+    vi.spyOn(console, 'log').mockImplementation(() => {});
+
+    const result = await runDoctor();
+
+    expect(result.exitCode).toBe(1);
+    expect(result.checks.find((check) => check.label === 'freemodel')).toMatchObject({ required: true, status: 'fail' });
+  });
+
+  it('never prints a configured credential and does not send it to a provider', async () => {
+    createProject({
+      schemaVersion: 1,
+      projectName: 'doctor-test',
+      providers: { freemodel: { baseURL: 'http://127.0.0.1:9000/v1', apiKey: 'synthetic-doctor-key-not-real-123456' } },
+      agents: [{ id: 'API', runtime: 'api', provider: 'freemodel', model: 'local-test' }],
+    });
+    const requests = vi.fn(async () => new Response());
+    vi.stubGlobal('fetch', requests);
+    const log = vi.spyOn(console, 'log').mockImplementation(() => {});
+
+    const result = await runDoctor();
+
+    expect(result.exitCode).toBe(0);
+    expect(log.mock.calls.flat().join('\n')).not.toContain('synthetic-doctor-key-not-real-123456');
+    expect(requests).not.toHaveBeenCalled();
+  });
+
+  it('keeps an absent Industrial engine optional for non-Industrial projects', async () => {
+    createProject(localConfig());
+    vi.spyOn(console, 'log').mockImplementation(() => {});
+
+    const result = await runDoctor();
+
+    expect(result.checks.some((check) => check.label === 'Rust engine')).toBe(false);
+    expect(result.exitCode).toBe(0);
+  });
+
+  it('requires and verifies engine identity and protocol for Industrial projects', async () => {
+    createProject(localConfig({ profile: { id: 'industrial', mode: 'sovereign-local' } }));
+    engine.verifyExecutable.mockReturnValue({ executablePath: 'engine.exe', executableHash: 'a'.repeat(64), engineVersion: '0.1.0', protocolVersion: '1.0' });
+    engine.engineHealth.mockReturnValue({
+      operation: 'health',
+      version: '1.0',
+      data: { status: 'ok', engine: 'maos-industrial-engine', version: '0.1.0', protocol_version: '1.0', unsafe_code: false },
+    });
+    vi.spyOn(console, 'log').mockImplementation(() => {});
+
+    const ready = await runDoctor();
+    expect(ready.checks.find((check) => check.label === 'Rust engine')).toMatchObject({ required: true, status: 'pass' });
+
+    engine.engineHealth.mockReturnValue({
+      operation: 'health',
+      version: '2.0',
+      data: { status: 'ok', engine: 'other-engine', version: '9.9.9', protocol_version: '2.0', unsafe_code: false },
+    });
+    const incompatible = await runDoctor();
+    expect(incompatible.exitCode).toBe(1);
+    expect(incompatible.checks.find((check) => check.label === 'Rust engine')).toMatchObject({ required: true, status: 'fail' });
+
+    engine.verifyExecutable.mockImplementation(() => {
+      const error = new Error('Engine executable not found at the required project path.') as Error & { category: string };
+      error.category = 'missing_binary';
+      throw error;
+    });
+    const missing = await runDoctor();
+    expect(missing.exitCode).toBe(1);
+    expect(missing.checks.find((check) => check.label === 'Rust engine')?.detail).toContain('required project path');
+  });
+
+  it('handles malformed configuration as a readiness failure without throwing', async () => {
+    const root = createProject();
+    fs.mkdirSync(path.join(root, '.maos'), { recursive: true });
+    fs.writeFileSync(path.join(root, '.maos', 'maos.config.json'), '{');
+    vi.spyOn(console, 'log').mockImplementation(() => {});
+
+    const result = await runDoctor();
+
+    expect(result.exitCode).toBe(1);
+    expect(result.checks.find((check) => check.label === 'Config')?.detail).toContain('malformed');
+  });
+});
