@@ -0,0 +1,83 @@
+/**
+ * Completion-refusal demo UI (TASK W2). Static-markup tests in the established
+ * ui1-25 pattern (renderToStaticMarkup; no DOM interaction harness exists).
+ *
+ * Proves the demo action is labelled, bound to the presented analysis, and
+ * that a refusal reason renders verbatim. The click path delegates to the
+ * existing TelemetryReviewCoordinator.prepareReview (covered by the
+ * telemetry-review-coordinator suite); the refusal itself comes from the
+ * real prepareAgentJudgedRun gate (covered by agent-review-refusal.test.ts).
+ */
+import { describe, expect, it } from 'vitest';
+import React from 'react';
+import { renderToStaticMarkup } from 'react-dom/server';
+import { CompletionRefusalDemo } from '../../src/gui/src/components/CompletionRefusalDemo';
+import { TelemetryReviewPanel } from '../../src/gui/src/components/TelemetryReviewPanel';
+
+const ANALYSIS_ID = 'telemetry-1793000000000-abcdef12';
+const LABEL = 'Try to claim completion without the required tool';
+
+describe('completion refusal demo', () => {
+  it('renders the labelled claim action for the presented analysis', () => {
+    const html = renderToStaticMarkup(
+      React.createElement(CompletionRefusalDemo, {
+        analysisId: ANALYSIS_ID,
+        reviewBusy: false,
+        reviewError: null,
+        actionsDisabled: false,
+        onClaim: () => {},
+      }),
+    );
+
+    expect(html).toContain(LABEL);
+    expect(html).toContain(`aria-label="${LABEL}"`);
+    expect(html).not.toContain('disabled');
+    expect(html).not.toContain('role="alert"');
+  });
+
+  it('disables the action while a request is busy or actions are disabled', () => {
+    const busyHtml = renderToStaticMarkup(
+      React.createElement(CompletionRefusalDemo, {
+        analysisId: ANALYSIS_ID,
+        reviewBusy: true,
+        reviewError: null,
+        actionsDisabled: false,
+        onClaim: () => {},
+      }),
+    );
+    const blockedHtml = renderToStaticMarkup(
+      React.createElement(CompletionRefusalDemo, {
+        analysisId: ANALYSIS_ID,
+        reviewBusy: false,
+        reviewError: null,
+        actionsDisabled: true,
+        onClaim: () => {},
+      }),
+    );
+
+    expect(busyHtml).toContain('disabled');
+    expect(blockedHtml).toContain('disabled');
+  });
+
+  it('shows the gate refusal reason verbatim when the claim is refused', () => {
+    const reason = 'Accepted agent report was not found inside the active project.';
+    const html = renderToStaticMarkup(
+      React.createElement(CompletionRefusalDemo, {
+        analysisId: ANALYSIS_ID,
+        reviewBusy: false,
+        reviewError: reason,
+        actionsDisabled: false,
+        onClaim: () => {},
+      }),
+    );
+
+    expect(html).toContain('role="alert"');
+    expect(html).toContain(reason);
+  });
+
+  it('offers no claim action before any analysis exists', () => {
+    const html = renderToStaticMarkup(React.createElement(TelemetryReviewPanel));
+
+    expect(html).not.toContain(LABEL);
+  });
+});
diff --git a/tests/industrial/agent-review-refusal.test.ts b/tests/industrial/agent-review-refusal.test.ts
new file mode 100644
index 0000000..c20ca3a
--- /dev/null
+++ b/tests/industrial/agent-review-refusal.test.ts
@@ -0,0 +1,65 @@
+/**
+ * Agent-review completion gate refusal (TASK W2).
+ *
+ * Proves, against the real gate (prepareAgentJudgedRun, the same function the
+ * GUI review path calls via POST /api/v1/industrial/judged-runs), that asking
+ * to accept an analysis with no qualifying agent tool work is refused — and
+ * that the refusal creates no review artifacts. No provider, no hosted calls,
+ * no API key: the gate throws before any engine, audit-chain, or model use.
+ */
+import * as fs from 'node:fs';
+import * as os from 'node:os';
+import * as path from 'node:path';
+import { afterEach, describe, expect, it } from 'vitest';
+import { prepareAgentJudgedRun } from '../../src/industrial/judged-run';
+import { createServiceContainer } from '../../src/service';
+
+const roots: string[] = [];
+const ANALYSIS_ID = 'telemetry-1793000000000-abcdef12';
+
+function makeProject(): string {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'maos-refusal-'));
+  roots.push(root);
+  fs.mkdirSync(path.join(root, '.maos'), { recursive: true });
+  fs.writeFileSync(path.join(root, '.maos', 'maos.config.json'), JSON.stringify({ projectName: 'maos-refusal-test' }));
+  return root;
+}
+
+function allFiles(root: string): string[] {
+  const out: string[] = [];
+  const walk = (dir: string): void => {
+    for (const entry of fs.readdirSync(dir, { withFileTypes: true })) {
+      const full = path.join(dir, entry.name);
+      if (entry.isDirectory()) walk(full);
+      else out.push(path.relative(root, full).split(path.sep).join('/'));
+    }
+  };
+  walk(root);
+  return out.sort();
+}
+
+afterEach(() => {
+  for (const root of roots.splice(0)) fs.rmSync(root, { recursive: true, force: true });
+});
+
+describe('agent review completion gate refuses work without qualifying tool execution', () => {
+  it('refuses to prepare a review when no accepted agent report exists', () => {
+    const root = makeProject();
+    const services = createServiceContainer(root);
+
+    expect(() => prepareAgentJudgedRun(root, services, ANALYSIS_ID))
+      .toThrow('Accepted agent report was not found inside the active project.');
+  });
+
+  it('creates no review artifacts on refusal', () => {
+    const root = makeProject();
+    const services = createServiceContainer(root);
+    const before = allFiles(root);
+
+    expect(() => prepareAgentJudgedRun(root, services, ANALYSIS_ID)).toThrow();
+
+    expect(allFiles(root)).toEqual(before);
+    expect(fs.existsSync(path.join(root, '.maos', 'industrial-runs', `judged-run-agent-${ANALYSIS_ID}.json`))).toBe(false);
+    expect(fs.existsSync(path.join(root, '.maos', 'industrial', 'telemetry-analyses', 'agent-reports'))).toBe(false);
+  });
+});
