+
+    const response = await provider.generate(
+      [{ role: 'user', content: 'Analyze the selected CSV.' }],
+      [{ type: 'function', function: { name: 'analyze_telemetry_csv', description: 'Analyze the selected CSV.', parameters: { type: 'object' } } }],
+      { maxTokens: 256 },
