+function waitForDownload(app, savePath, timeoutMs = 30_000) {
+  return app.evaluate(({ BrowserWindow }, options) => new Promise((resolve) => {
+    const window = BrowserWindow.getAllWindows().find((candidate) => !candidate.isDestroyed());
