diff --git a/tests/gui/rest-client-abort.test.ts b/tests/gui/rest-client-abort.test.ts
new file mode 100644
index 0000000..6b18729
--- /dev/null
+++ b/tests/gui/rest-client-abort.test.ts
@@ -0,0 +1,68 @@
+/**
+ * REST client abort hardening (COMPLETION-FIX-10 finding 1).
+ * A pre-aborted caller signal must not start a request, and the forwarding
+ * listener must always be cleaned up. Loopback/injected fetch only.
+ */
+import { describe, expect, it, vi } from 'vitest';
+import { BrowserRestClient } from '../../src/gui/src/api/rest-client';
+
+function okFetch(body: unknown = { data: {} }) {
+  return vi.fn(async () => ({
+    ok: true,
+    status: 200,
+    headers: { get: () => null },
+    text: async () => JSON.stringify(body),
+  }));
+}
+
+function clientWith(fetchFn: ReturnType<typeof vi.fn>) {
+  return new BrowserRestClient({
+    baseUrl: 'http://127.0.0.1:9',
+    projectRoot: 'C:\\maos-test',
+    fetchFn: fetchFn as unknown as typeof fetch,
+    defaultTimeoutMs: 5_000,
+  });
+}
+
+describe('BrowserRestClient abort handling', () => {
+  it('does not start a request when the caller signal is already aborted', async () => {
+    const fetchFn = okFetch();
+    const client = clientWith(fetchFn);
+    const controller = new AbortController();
+    controller.abort();
+    const removeSpy = vi.spyOn(controller.signal, 'removeEventListener');
+
+    await expect(client.request('GET', '/api/v1/chat/health', undefined, { signal: controller.signal }))
+      .rejects.toMatchObject({ name: 'AbortError' });
+    expect(fetchFn).not.toHaveBeenCalled();
+    expect(removeSpy).not.toHaveBeenCalled();
+  });
+
+  it('detaches the forwarding listener once a normal request settles', async () => {
+    const fetchFn = okFetch();
+    const client = clientWith(fetchFn);
+    const controller = new AbortController();
+    const removeSpy = vi.spyOn(controller.signal, 'removeEventListener');
+    const addSpy = vi.spyOn(controller.signal, 'addEventListener');
+
+    await client.request('GET', '/api/v1/chat/health', undefined, { signal: controller.signal, timeoutMs: 5_000 });
+    expect(fetchFn).toHaveBeenCalledTimes(1);
+    expect(addSpy).toHaveBeenCalledWith('abort', expect.any(Function));
+    expect(removeSpy).toHaveBeenCalledWith('abort', expect.any(Function));
+    controller.abort();
+  });
+
+  it('still maps a mid-flight abort to a timeout', async () => {
+    const fetchFn = vi.fn(async (_input: unknown, init?: { signal?: AbortSignal }) => {
+      await new Promise<void>((_resolve, reject) => {
+        init?.signal?.addEventListener('abort', () => reject(new DOMException('Aborted.', 'AbortError')), { once: true });
+      });
+      throw new Error('unreachable');
+    });
+    const client = clientWith(fetchFn);
+    const controller = new AbortController();
+    const pending = client.request('GET', '/api/v1/chat/health', undefined, { signal: controller.signal, timeoutMs: 5_000 });
+    controller.abort();
+    await expect(pending).rejects.toMatchObject({ name: 'TimeoutError' });
+  });
+});
