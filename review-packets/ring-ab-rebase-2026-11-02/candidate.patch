+        if (!kind) {
+          onError('Refused ' + file.name + ': only PDF, image, or CSV attachments are accepted.');
+          continue;
+        }
+        if (file.size > RING_ATTACH_MAX_BYTES || file.size < 1) {
+          onError('Refused ' + file.name + ': file must be between 1 byte and 5 MB.');
+          continue;
+        }
