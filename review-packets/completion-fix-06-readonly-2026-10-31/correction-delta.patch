index 0000000..c3f1a3a
--- /dev/null
+++ b/tests/gui/telemetry-review-coordinator.test.ts
@@ -0,0 +1,210 @@
+/**
+ * Behavioral coverage for the panel's delegated async/state coordination
+ * (COMPLETION-FIX-06). These tests drive TelemetryReviewCoordinator — the
+ * exact implementation TelemetryReviewPanel delegates every review side
+ * effect to — with deferred promises and fake adapters/storage/navigation.
+ * No new test dependencies; node vitest only, matching the GUI test approach.
+ */
+import { describe, expect, it, vi } from 'vitest';
+import {
+  TelemetryReviewCoordinator,
+  type TelemetryReviewAdapter,
+  type TelemetryReviewViewState,
+} from '../../src/gui/src/components/telemetryReviewCoordinator';
+
+function deferred<T>() {
+  let resolve!: (value: T) => void;
+  let reject!: (reason?: unknown) => void;
+  const promise = new Promise<T>((res, rej) => { resolve = res; reject = rej; });
+  return { promise, resolve, reject };
+}
+
+interface FakeAdapter extends TelemetryReviewAdapter {
+  telemetryCalls: Array<{ input: unknown; options: unknown }>;
+  csvCalls: Array<{ input: unknown; options: unknown }>;
+  prepareCalls: string[];
+  judgedCalls: string[];
+  telemetryQueue: Array<ReturnType<typeof deferred<any>>>;
+  csvQueue: Array<ReturnType<typeof deferred<any>>>;
+  prepareQueue: Array<ReturnType<typeof deferred<any>>>;
+  judgedQueue: Array<ReturnType<typeof deferred<any>>>;
+}
+
+function makeAdapter(): FakeAdapter {
+  const fake: FakeAdapter = {
+    telemetryCalls: [],
+    csvCalls: [],
+    prepareCalls: [],
+    judgedCalls: [],
+    telemetryQueue: [],
+    csvQueue: [],
+    prepareQueue: [],
+    judgedQueue: [],
+    analyzeTelemetry: vi.fn(async (input: unknown, options: unknown) => {
+      fake.telemetryCalls.push({ input, options });
+      const next = fake.telemetryQueue.shift();
+      if (!next) throw new Error('No queued telemetry response.');
+      return next.promise;
+    }),
+    analyzeCsv: vi.fn(async (input: unknown, options: unknown) => {
+      fake.csvCalls.push({ input, options });
+      const next = fake.csvQueue.shift();
+      if (!next) throw new Error('No queued agent response.');
+      return next.promise;
+    }),
+    prepareReview: vi.fn(async (analysisId: string) => {
+      fake.prepareCalls.push(analysisId);
+      const next = fake.prepareQueue.shift();
+      if (!next) throw new Error('No queued review response.');
+      return next.promise;
+    }),
+    getJudgedRun: vi.fn(async (runId: string) => {
+      fake.judgedCalls.push(runId);
+      const next = fake.judgedQueue.shift();
+      if (!next) throw new Error('No queued judged response.');
+      return next.promise;
+    }),
+  };
+  return fake;
+}
+
+interface Harness {
+  coordinator: TelemetryReviewCoordinator;
+  adapter: FakeAdapter;
+  patches: Array<Partial<TelemetryReviewViewState>>;
+  writes: string[];
+  navigations: number;
+  savedRunId: string | null;
+}
+
+function makeHarness(savedRunId: string | null = null): Harness {
+  const patches: Array<Partial<TelemetryReviewViewState>> = [];
+  const writes: string[] = [];
+  let navigations = 0;
+  const adapter = makeAdapter();
+  const harness: Harness = {
+    coordinator: new TelemetryReviewCoordinator(adapter, {
+      apply: (patch) => { patches.push(patch); },
+      readSavedRunId: () => harness.savedRunId,
+      writeSavedRunId: (runId) => { writes.push(runId); },
+      navigateToApprovals: () => { navigations += 1; },
+    }),
+    adapter,
+    patches,
+    writes,
+    get navigations() { return navigations; },
+    savedRunId,
+  };
+  return harness;
+}
+
+const fileA = { name: 'a.csv', size: 136, lastModified: 1793433790000 };
+const fileB = { name: 'b.csv', size: 140, lastModified: 1793433799999 };
+
+function uploadReceipt(analysisId: string, relativePath: string) {
+  return { analysisId, source: { relativePath }, result: { rowsAnalyzed: 3 } };
+}
+
+function agentResult() {
+  return { evidence: { analysisId: 'telemetry-1' } };
+}
+
+function judgedRun(runId: string, status = 'pending_approval') {
+  return { runId, status };
+}
+
+describe('telemetry review coordinator lifetimes (COMPLETION-FIX-06)', () => {
+  it('prepare A, select B, resolve A: no stale review, storage, navigation or error', async () => {
+    const h = makeHarness();
+    h.coordinator.selectFile(fileA);
+    const prepA = deferred();
+    h.adapter.prepareQueue.push(prepA);
+    const pending = h.coordinator.prepareReview('analysis-a');
+    h.coordinator.selectSample();
+    prepA.resolve(judgedRun('judged-run-agent-a'));
+    await pending;
+
+    expect(h.adapter.prepareCalls).toEqual(['analysis-a']);
+    expect(h.patches.some((patch) => patch.reviewRun != null)).toBe(false);
+    expect(h.patches.some((patch) => patch.reviewError != null)).toBe(false);
+    expect(h.writes).toEqual([]);
+    expect(h.navigations).toBe(0);
+  });
+
+  it('prepare A, select B, start B, finish A: B stays busy until B finishes', async () => {
+    const h = makeHarness();
+    h.coordinator.selectFile(fileA);
+    const prepA = deferred();
+    h.adapter.prepareQueue.push(prepA);
+    const pendingA = h.coordinator.prepareReview('analysis-a');
+    h.coordinator.selectSample();
+    const prepB = deferred();
+    h.adapter.prepareQueue.push(prepB);
+    const pendingB = h.coordinator.prepareReview('analysis-b');
+    prepA.resolve(judgedRun('judged-run-agent-a'));
+    await pendingA;
+
+    const busyAfterA = h.patches.filter((patch) => patch.reviewBusy !== undefined).map((patch) => patch.reviewBusy);
+    expect(busyAfterA[busyAfterA.length - 1]).toBe(true);
+
+    prepB.resolve(judgedRun('judged-run-agent-b'));
+    await pendingB;
+    const busyAfterB = h.patches.filter((patch) => patch.reviewBusy !== undefined).map((patch) => patch.reviewBusy);
+    expect(busyAfterB[busyAfterB.length - 1]).toBe(false);
+    expect(h.writes).toEqual(['judged-run-agent-b']);
+    expect(h.navigations).toBe(1);
+  });
+
+  it('file A then sample: no request for A runs under the sample identity', async () => {
+    const h = makeHarness();
+    h.coordinator.selectFile(fileA);
+    h.coordinator.selectSample();
+
+    expect(h.coordinator.getActiveSourceKey()).toBe('sample');
+    await h.coordinator.askAboutCsv('Summarize.', { ...fileA, contentBase64: 'e30=' });
+
+    expect(h.adapter.telemetryCalls).toHaveLength(0);
+    expect(h.adapter.csvCalls).toHaveLength(0);
+    expect(h.patches.some((patch) => patch.agentPhase === 'uploading' || patch.agentPhase === 'requesting')).toBe(false);
+  });
+
+  it('sample then a new file: requests and results bind to that file', async () => {
+    const h = makeHarness();
+    h.coordinator.selectSample();
+    h.coordinator.selectFile(fileB);
+    const upload = deferred();
+    h.adapter.telemetryQueue.push(upload);
+    const pending = h.coordinator.askAboutCsv('Summarize.', { ...fileB, contentBase64: 'e30=' });
+    expect(h.adapter.telemetryCalls).toHaveLength(1);
+    expect((h.adapter.telemetryCalls[0]?.input as { name?: string }).name).toBe('b.csv');
+    upload.resolve(uploadReceipt('telemetry-b', '.maos/industrial/evidence/b.csv'));
+    const agentCall = deferred();
+    h.adapter.csvQueue.push(agentCall);
+    await vi.waitFor(() => expect(h.adapter.csvCalls).toHaveLength(1));
+    agentCall.resolve(agentResult());
+    await pending;
+
+    const lastResult = [...h.patches].reverse().find((patch) => patch.agentResult !== undefined);
+    expect(lastResult?.agentResult).not.toBeNull();
+    expect(h.patches.some((patch) => patch.agentPhase === 'completed')).toBe(true);
+  });
+
+  it('stale reconnect and stale analysis results stay ignored', async () => {
+    const h = makeHarness('judged-run-agent-old');
+    const judged = deferred();
+    h.adapter.judgedQueue.push(judged);
+    const reconnecting = h.coordinator.reconnect();
+    h.coordinator.selectFile(fileA);
+    judged.resolve(judgedRun('judged-run-agent-old', 'completed'));
+    await reconnecting;
+    expect(h.patches.some((patch) => patch.reviewRun != null)).toBe(false);
+
+    const analysis = deferred();
+    h.adapter.telemetryQueue.push(analysis);
+    const analyzing = h.coordinator.runSampleAnalysis();
+    h.coordinator.selectFile(fileB);
+    analysis.resolve(uploadReceipt('telemetry-stale', 'synthetic/pilot.csv'));
+    await analyzing;
+    expect(h.patches.some((patch) => patch.analysis != null)).toBe(false);
+  });
+});
